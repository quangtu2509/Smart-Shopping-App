# Documentation only: Gradle does not load this file. Set environment variables in your terminal.
DB_URL=jdbc:postgresql://localhost:5432/smart_shopping
DB_USER=smart_shopping_app
DB_PASSWORD=
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
ACCESS_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_SECONDS=900
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=
# Base64 encoding of at least 32 random bytes. Never commit an actual value.
AUTH_CHALLENGE_KEY=
