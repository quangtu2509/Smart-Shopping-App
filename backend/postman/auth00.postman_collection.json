              "pm.test(\"error details object\", () => pm.expect(response.error.details).to.be.an(\"object\"));",
              "pm.test(\"refresh invalid\", () => pm.expect(response.error.code).to.eql(\"REFRESH_TOKEN_INVALID\"));"
            ]
          }
        }
      ]
    },
