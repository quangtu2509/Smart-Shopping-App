    {
      "name": "API-AUTH-15 Verify recovery",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/password/verify",
        "body": {
          "mode": "raw",
          "raw": "{\"challenge_id\": \"{{reset_challenge_id}}\", \"code\": \"{{otp_code}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const fixture=pm.environment.get(\"fixture_url\");",
              "if(fixture) pm.sendRequest(fixture+\"?email=\"+encodeURIComponent(pm.collectionVariables.get(\"run_email\")),(err,res)=>{if(err)throw err;pm.variables.set(\"otp_code\",res.text());});",
              "else if(!pm.variables.get(\"otp_code\")) throw new Error(\"Enter the emailed code as local otp_code before sending this request.\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"reset_token\",pm.response.json().data.reset_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "API-AUTH-16 Reset password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/password/reset",
        "body": {
          "mode": "raw",
          "raw": "{\"reset_token\": \"{{reset_token}}\", \"password\": \"{{reset_password}}\", \"confirm_password\": \"{{reset_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get(\"reset_password\")) {",
              "  if (!pm.environment.get(\"fixture_url\")) {",
              "    console.warn(\"Set reset_password to your own private local password before sending a reset request. Never export populated variables.\");",
              "    pm.execution.skipRequest();",
              "  } else {",
              "    pm.collectionVariables.set(\"reset_password\", \"ResetLocal!\" + pm.variables.replaceIn(\"{{$guid}}\"));",
              "  }",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\",()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
