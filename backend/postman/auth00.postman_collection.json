    {
      "name": "API-AUTH-08 Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"no-store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "const response = pm.response.json();",
              "pm.test(\"request id\", () => pm.expect(response.meta.request_id).to.be.a(\"string\"));",
              "pm.test(\"no password or tokens\", () => { pm.expect(response.data).not.to.have.property(\"tokens\"); pm.expect(response.data.user).not.to.have.property(\"password_hash\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-AUTH-05 Sessions",
