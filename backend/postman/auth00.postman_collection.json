{
  "info": {
    "name": "Smart Shopping Auth — OTP, Google, sessions and recovery",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local auth assertions. Credentials are generated per run and remain in memory; never export populated variables."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080/api/v1"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"run_email\")) {",
          "  if (!pm.environment.get(\"fixture_url\")) throw new Error(\"Set run_email to your own Gmail and run_password locally before sending real email.\");",
          "  const id = pm.variables.replaceIn(\"{{$guid}}\");",
          "  pm.collectionVariables.set(\"run_email\", \"postman-\" + id + \"@gmail.com\");",
          "  pm.collectionVariables.set(\"run_password\", \"LocalTest!\" + id);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "API-AUTH-01 Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{run_email}}\", \"password\": \"{{run_password}}\", \"confirm_password\": \"{{run_password}}\", \"device_name\": \"Postman local test\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202\",()=>pm.response.to.have.status(202));",
              "const response=pm.response.json();",
              "pm.collectionVariables.set(\"challenge_id\",response.data.challenge_id);",
              "pm.test(\"No credentials before proof\",()=>pm.expect(response.data).not.to.have.property(\"tokens\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-AUTH-10 Resend cooldown",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/email/resend",
        "body": {
          "mode": "raw",
          "raw": "{\"challenge_id\": \"{{challenge_id}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const fixture = pm.environment.get(\"fixture_url\");",
              "pm.test(fixture ? \"HTTP 429\" : \"HTTP 202 or 429\", () => {",
              "  if (fixture) pm.response.to.have.status(429);",
              "  else pm.expect(pm.response.code).to.be.oneOf([202, 429]);",
              "});",
              "if (!fixture && pm.response.code === 202) {",
              "  const challengeId = pm.response.json().data?.challenge_id;",
              "  const valid = typeof challengeId === \"string\" && challengeId.length > 0;",
              "  pm.test(\"Resend returns a verification challenge\", () => pm.expect(valid).to.eql(true));",
              "  if (valid) {",
              "    pm.collectionVariables.set(\"challenge_id\", challengeId);",
              "    pm.variables.unset(\"otp_code\");",
              "    pm.environment.unset(\"otp_code\");",
              "    pm.collectionVariables.unset(\"otp_code\");",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "API-AUTH-09 Verify registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/email/verify",
        "body": {
          "mode": "raw",
          "raw": "{\"challenge_id\": \"{{challenge_id}}\", \"code\": \"{{otp_code}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const fixture=pm.environment.get(\"fixture_url\");",
              "if(fixture) pm.sendRequest(fixture+\"?email=\"+encodeURIComponent(pm.collectionVariables.get(\"run_email\")),(err,res)=>{if(err)throw err;pm.variables.set(\"otp_code\",res.text());});",
              "else if(!pm.variables.get(\"otp_code\")) throw new Error(\"Enter the emailed code as local otp_code before sending this request.\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"no-store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "const response = pm.response.json();",
              "pm.test(\"request id\", () => pm.expect(response.meta.request_id).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"access_token\", response.data.tokens.access_token);",
              "pm.collectionVariables.set(\"refresh_token\", response.data.tokens.refresh_token);",
              "pm.collectionVariables.set(\"session_id\", response.data.tokens.auth_session_id);",
              "pm.test(\"default profile\", () => { pm.expect(response.data.profile.max_stores).to.eql(3); pm.expect(response.data.profile.optimization_mode).to.eql(\"BALANCED\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{run_email}}\", \"password\": \"{{run_password}}\", \"confirm_password\": \"{{run_password}}\", \"device_name\": \"Postman local test\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"no-store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "const response = pm.response.json();",
              "pm.test(\"request id\", () => pm.expect(response.meta.request_id).to.be.a(\"string\"));",
              "pm.test(\"error details object\", () => pm.expect(response.error.details).to.be.an(\"object\"));",
              "pm.test(\"duplicate code\", () => pm.expect(response.error.code).to.eql(\"EMAIL_ALREADY_EXISTS\"));"
            ]
          }
        }
      ]
    },
