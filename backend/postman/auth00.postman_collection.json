        "body": {
          "mode": "raw",
          "raw": "{\"refresh_token\": \"unknown\", \"owner_id\": \"other\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"no-store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "const response = pm.response.json();",
              "pm.test(\"request id\", () => pm.expect(response.meta.request_id).to.be.a(\"string\"));",
              "pm.test(\"error details object\", () => pm.expect(response.error.details).to.be.an(\"object\"));",
              "pm.test(\"unknown field code\", () => pm.expect(response.error.code).to.eql(\"UNKNOWN_FIELD\"));"
            ]
          }
        }
      ]
    },
