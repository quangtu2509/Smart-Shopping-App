              "const response = pm.response.json();",
              "pm.test(\"request id\", () => pm.expect(response.meta.request_id).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"used_refresh\", pm.collectionVariables.get(\"refresh_token\"));",
              "pm.collectionVariables.set(\"old_access\", pm.collectionVariables.get(\"access_token\"));",
              "pm.collectionVariables.set(\"access_token\", response.data.access_token);",
              "pm.collectionVariables.set(\"refresh_token\", response.data.refresh_token);"
            ]
          }
        }
      ]
