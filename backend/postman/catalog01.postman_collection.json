{
  "info": {
    "name": "Smart Shopping CATALOG-01 (isolated fixture)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Only fake catalog and temporary PostgreSQL 55432. Never run against development."
  },
  "item": [
    {
      "name": "Auth required",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/plans/{{plan_id}}/catalog"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401',()=>pm.response.to.have.status(401));",
              "pm.test('request id',()=>pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Catalog first page",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/plans/{{plan_id}}/catalog?limit=2&sort=PRICE_ASC"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('request id',()=>pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string'));",
              "const d=pm.response.json().data;",
              "pm.test('page offers and decimal prices',()=>{pm.expect(d.items.length).eq(2);pm.expect(d.items[0].price).to.be.a('string');pm.expect(d.items[0].price_scope).eq('RETAILER');});",
              "pm.test('no upstream raw data',()=>{pm.expect(d.items[0]).not.to.have.property('raw');});",
              "pm.environment.set('cursor',d.next_cursor);pm.environment.set('product_id',d.items[0].product.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Catalog next page",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/plans/{{plan_id}}/catalog?limit=2&sort=PRICE_ASC&cursor={{cursor}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('request id',()=>pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string'));",
              "pm.test('next page',()=>pm.expect(pm.response.json().data.items.length).eq(2));"
            ]
          }
        }
      ]
    },
