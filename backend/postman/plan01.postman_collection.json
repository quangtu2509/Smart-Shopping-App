          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test(\"Request ID\",()=>pm.expect(b.meta.request_id).to.be.a(\"string\"));",
              "pm.test(\"Real reference\",()=>pm.expect(b.data.items.some(x=>x.id===\"plan-food\")).to.equal(true));"
            ]
          }
        }
      ]
    },
