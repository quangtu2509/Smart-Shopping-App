    {
      "name": "Version conflict",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{plan_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "conflicting-edit"
          }
        ],
        "url": "{{base_url}}/plans/{{plan_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"expected_version\": 1, \"budget\": \"800000\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\",()=>pm.response.to.have.status(409));",
              "const b=pm.response.json();",
              "pm.test(\"Request ID\",()=>pm.expect(b.meta.request_id).to.be.a(\"string\"));",
              "pm.test(\"Conflict context\",()=>{pm.expect(b.error.code).to.equal(\"VERSION_CONFLICT\");pm.expect(b.error.details.current_version).to.equal(2);});"
            ]
          }
        }
      ]
