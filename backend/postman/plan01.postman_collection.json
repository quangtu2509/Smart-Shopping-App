            "key": "Idempotency-Key",
            "value": "invalid-budget"
          }
        ],
        "url": "{{base_url}}/plans",
        "body": {
          "mode": "raw",
          "raw": "{\"budget\": \"0\", \"currency\": \"VND\", \"selections\": [{\"retailer_id\": \"plan-retailer-a\", \"store_id\": null}], \"category_ids\": [\"plan-food\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\",()=>pm.response.to.have.status(422));",
              "const b=pm.response.json();",
              "pm.test(\"Request ID\",()=>pm.expect(b.meta.request_id).to.be.a(\"string\"));",
              "pm.test(\"Field error\",()=>pm.expect(b.error.field_errors[0].field).to.equal(\"budget\"));"
            ]
          }
        }
      ]
    },
