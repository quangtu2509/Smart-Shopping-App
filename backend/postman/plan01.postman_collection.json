              "pm.test(\"Request ID\",()=>pm.expect(b.meta.request_id).to.be.a(\"string\"));",
              "pm.test(\"Internal coverage explicit\",()=>{pm.expect(b.data.map.status).to.equal(\"PARTIAL\");pm.expect(b.data.map.warnings[0].code).to.equal(\"PLACES_NOT_CONNECTED\");});"
            ]
          }
        }
