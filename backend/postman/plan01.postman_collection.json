{
  "info": {
    "name": "PLAN-01 Draft and selection contract",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Retailer references",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{plan_token}}"
          }
        ],
        "url": "{{base_url}}/retailers?q=C%E1%BB%ADa%20h%C3%A0ng%20th%E1%BB%AD%20nghi%E1%BB%87m&limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test(\"Request ID\",()=>pm.expect(b.meta.request_id).to.be.a(\"string\"));",
              "pm.test(\"Paged references\",()=>{pm.expect(b.data.items).to.have.length(1);pm.expect(b.data.next_cursor).to.be.a(\"string\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "Category references",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
