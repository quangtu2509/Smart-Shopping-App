    {
      "name": "Save Draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{plan_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{create_key}}"
          }
        ],
        "url": "{{base_url}}/plans",
        "body": {
          "mode": "raw",
          "raw": "{\"budget\": \"500000\", \"currency\": \"VND\", \"selections\": [{\"retailer_id\": \"plan-retailer-a\", \"store_id\": null}], \"category_ids\": [\"plan-food\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const b=pm.response.json();",
              "pm.test(\"Request ID\",()=>pm.expect(b.meta.request_id).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"plan_id\",b.data.plan.id);",
              "pm.test(\"Draft persisted\",()=>{pm.expect(b.data.plan.version).to.equal(1);pm.expect(b.data.plan.revision).to.equal(0);pm.expect(b.data.plan.status).to.equal(\"DRAFT\");pm.expect(b.data.items).to.have.length(0);pm.expect(pm.response.headers.get(\"Location\")).to.equal(\"/api/v1/plans/\"+b.data.plan.id);});"
            ]
          }
        }
      ]
    },
